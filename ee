@app.route("/")
def home():

    db = get_db()
    cur = db.cursor()

    # --------------------------------------------------------
    # STATISTIQUES
    # --------------------------------------------------------

    cur.execute("""
        SELECT COUNT(*) AS total
        FROM salles
    """)

    nombre_salles = cur.fetchone()["total"]

    cur.execute("""
        SELECT COUNT(*) AS total
        FROM equipements
    """)

    nombre_equipements = cur.fetchone()["total"]

    cur.execute("""
        SELECT COUNT(*) AS total
        FROM alertes
    """)

    nombre_alertes = cur.fetchone()["total"]

    cur.execute("""
        SELECT COUNT(*) AS total
        FROM optimisations
    """)

    nombre_optimisations = cur.fetchone()["total"]

    cur.execute("""
        SELECT COALESCE(SUM(energie),0) AS total
        FROM consommations
    """)

    energie_totale = safe_float(
        cur.fetchone()["total"]
    )

    # --------------------------------------------------------
    # DERNIÈRE PUISSANCE
    # --------------------------------------------------------

    cur.execute("""
        SELECT SUM(puissance) AS puissance
        FROM consommations
        WHERE date_heure = (
            SELECT MAX(date_heure)
            FROM consommations
        )
    """)

    puissance_actuelle = safe_float(
        cur.fetchone()["puissance"]
    )

    # --------------------------------------------------------
    # SALLES
    # --------------------------------------------------------

    cur.execute("""
        SELECT
            s.id,
            s.nom,
            s.description,
            s.localisation,
            COALESCE(SUM(c.energie),0) AS energie

        FROM salles s

        LEFT JOIN equipements e
            ON e.salle_id = s.id

        LEFT JOIN consommations c
            ON c.equipement_id = e.id

        GROUP BY
            s.id,
            s.nom,
            s.description,
            s.localisation

        ORDER BY s.id
    """)

    salles = cur.fetchall()

    # --------------------------------------------------------
    # DERNIÈRE MESURE
    # --------------------------------------------------------

    cur.execute("""
        SELECT MAX(date_heure) AS date
        FROM consommations
    """)

    derniere_mesure = cur.fetchone()["date"]

    db.close()

    # --------------------------------------------------------
    # ICÔNES DES SALLES
    # --------------------------------------------------------

    icones = {
        "Salle informatique": "💻",
