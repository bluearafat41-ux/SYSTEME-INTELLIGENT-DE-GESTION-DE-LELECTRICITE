    db = get_db()
    cur = db.cursor()

    cur.execute("""
        SELECT
            o.*,
            s.nom AS salle,
            e.nom AS equipement

        FROM optimisations o

        LEFT JOIN salles s
            ON s.id = o.salle_id

        LEFT JOIN equipements e
            ON e.id = o.equipement_id

        ORDER BY o.date_heure DESC

        LIMIT 100
    """)

    optimisations_data = cur.fetchall()

