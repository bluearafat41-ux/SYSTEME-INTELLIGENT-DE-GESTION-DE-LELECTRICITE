            <td>
                {equipement["etat"] or "-"}
            </td>

            <td>
                {safe_float(equipement["puissance"]):.3f} kW
            </td>

            <td>
                {safe_float(equipement["energie"]):.3f} kWh
            </td>

        </tr>

        """

    content = f"""

