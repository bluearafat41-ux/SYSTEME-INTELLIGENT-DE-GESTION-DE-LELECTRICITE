@app.route("/salle/<int:salle_id>")
def salle(salle_id):

    db = get_db()
    cur = db.cursor()

    cur.execute("""
        SELECT *
        FROM salles
        WHERE id = ?
    """, (salle_id,))

    salle_data = cur.fetchone()

    if not salle_data:
        db.close()
        abort(404)

    # --------------------------------------------------------
    # ÉQUIPEMENTS
    # --------------------------------------------------------

    cur.execute("""
        SELECT
            e.id,
            e.nom,
            e.type,
            e.etat,
            COALESCE(SUM(c.energie),0) AS energie,
            COALESCE(AVG(c.puissance),0) AS puissance

        FROM equipements e

        LEFT JOIN consommations c
            ON c.equipement_id = e.id

        WHERE e.salle_id = ?

        GROUP BY
            e.id,
            e.nom,
            e.type,
            e.etat

        ORDER BY e.id
    """, (salle_id,))

    equipements = cur.fetchall()

    # --------------------------------------------------------
    # CONSOMMATION TOTALE
    # --------------------------------------------------------

    cur.execute("""
        SELECT
            COALESCE(SUM(c.energie),0) AS energie,
            COALESCE(AVG(c.puissance),0) AS puissance
        FROM consommations c

        JOIN equipements e
            ON e.id = c.equipement_id

        WHERE e.salle_id = ?
    """, (salle_id,))

    stats = cur.fetchone()

    # --------------------------------------------------------
    # HISTORIQUE PAR MESURE
    # --------------------------------------------------------

    cur.execute("""
        SELECT
            c.date_heure,
            SUM(c.energie) AS energie,
            SUM(c.puissance) AS puissance

        FROM consommations c

        JOIN equipements e
            ON e.id = c.equipement_id

        WHERE e.salle_id = ?

        GROUP BY c.date_heure

        ORDER BY c.date_heure DESC

        LIMIT 30
    """, (salle_id,))

    historique = list(
        reversed(cur.fetchall())
    )

    db.close()

    labels = [
        str(x["date_heure"])[11:16]
        for x in historique
    ]

    energie = [
        safe_float(x["energie"])
        for x in historique
    ]

    equip_labels = [
        x["nom"]
        for x in equipements
    ]

    equip_values = [
        safe_float(x["energie"])
        for x in equipements
    ]

    equip_html = ""

    for equipement in equipements:

        equip_html += f"""

        <tr>

            <td>
                <strong>
                    {equipement["nom"]}
                </strong>
            </td>

            <td>
                {equipement["type"] or "-"}
